[Unit]
Description=Private Tailscale edge for CLIProxyAPI
Wants=network-online.target tailscaled.service cliproxyapi.service
After=network-online.target tailscaled.service cliproxyapi.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --config /etc/cliproxyapi-edge/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cliproxy-edge

[Install]
WantedBy=multi-user.target
