[Unit]
Description=Bounded approved CLIProxyAPI companion backlog
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=cliproxy-worker
Group=cliproxy-worker
WorkingDirectory=/var/lib/cliproxy-fleet
EnvironmentFile=/etc/cliproxy-worker/proxy.env
ExecStart=/usr/bin/python3 /opt/cliproxyapi/companion/fleetctl.py --db /var/lib/cliproxy-fleet/inbox.sqlite run levi-thinkcentre-m700 --max-tasks 4
# Do not replay potentially completed tool effects after a crash.
Restart=no
TimeoutStartSec=infinity
UMask=0077
StateDirectory=cliproxy-fleet
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
# This unit is started explicitly after approval, never enabled as an idle loop.
